{
  "name": "memo-cabinet",
  "version": "1.8.2",
  "description": "화면 가장자리에서 빼꼼 나오는 메모·일정 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.kdwikorea.memocabinet",
    "productName": "빼꼬미",
    "publish": {
      "provider": "github",
      "owner": "David-Kimbit",
      "repo": "Memo"
    },
    "files": [
      "main.js",
      "schedule-main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "memo-cabinet-setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
